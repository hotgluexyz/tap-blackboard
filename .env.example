# blackboard Configuration
# Copy this file to .env and fill in your actual values.
# Variable names follow the tap's setting keys; run `tap-blackboard --about` for the
# authoritative list.

# Required: OAuth application key from the Blackboard developer portal
TAP_BLACKBOARD_CLIENT_ID=your_application_key_here

# Required: OAuth application secret from the Blackboard developer portal
TAP_BLACKBOARD_CLIENT_SECRET=your_application_secret_here

# Optional: The earliest record date to sync (ISO-8601)
TAP_BLACKBOARD_START_DATE=2000-01-01T00:00:00Z

# Optional: Blackboard Learn host root URL
TAP_BLACKBOARD_API_URL=https://bd-partner-a-original.blackboard.com

# Optional: comma-separated course primary keys to limit sync (JSON array in config.json)
# TAP_BLACKBOARD_COURSE_IDS=["_7_1","_1092_1"]
