{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "tap-blackboard discover",
            "type": "debugpy",
            "request": "launch",
            "module": "tap_blackboard.tap",
            "cwd": "${workspaceFolder}/.secrets",
            "args": [
                "--config",
                "config.json",
                "--discover",
                ">",
                "catalog.json"
            ],
            "justMyCode": false,
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal"
        },
        {
            "name": "tap-blackboard sync",
            "type": "debugpy",
            "request": "launch",
            "module": "tap_blackboard.tap",
            "cwd": "${workspaceFolder}/.secrets",
            "args": [
                "--config",
                "config.json",
                "--catalog",
                "catalog-selected.json",
                ">",
                "data.singer"
            ],
            "justMyCode": false,
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal"
        },
        {
            "name": "tap-blackboard sync state",
            "type": "debugpy",
            "request": "launch",
            "module": "tap_blackboard.tap",
            "cwd": "${workspaceFolder}/.secrets",
            "args": [
                "--config",
                "config.json",
                "--catalog",
                "catalog-selected.json",
                "--state",
                "state.json",
                ">",
                "data.singer"
            ],
            "justMyCode": false,
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal"
        }
    ]
}
